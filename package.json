{
  "name": "ortools-node",
  "version": "0.1.0",
  "description": "Native Node.js bindings for Google OR-Tools: LP and MIP with GLOP, PDLP, SCIP, CBC, HiGHS, CP-SAT and more",
  "keywords": [
    "or-tools",
    "ortools",
    "optimization",
    "operations-research",
    "linear-programming",
    "mixed-integer-programming",
    "lp",
    "mip",
    "milp",
    "solver",
    "glop",
    "scip",
    "highs",
    "cp-sat",
    "napi",
    "native"
  ],
  "homepage": "https://github.com/abdulazeem-m0uneer/ortools-node#readme",
  "bugs": {
    "url": "https://github.com/abdulazeem-m0uneer/ortools-node/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abdulazeem-m0uneer/ortools-node.git"
  },
  "author": "Abdulazeem Mouneer (https://github.com/abdulazeem-m0uneer)",
  "license": "MIT AND Apache-2.0",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "install": "node scripts/install.js",
    "build": "cmake-js compile",
    "rebuild": "cmake-js rebuild",
    "build:debug": "cmake-js compile --debug",
    "test": "node --test \"test/**/*.test.js\"",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "example": "node examples/basic.js",
    "bench": "node bench/run.js",
    "bench:dispatch": "node bench/dispatch/bench.js"
  },
  "dependencies": {
    "cmake-js": "^8.0.0",
    "node-addon-api": "^8.3.0"
  },
  "devDependencies": {
    "typescript": "5.6.3"
  },
  "binary": {
    "napi_versions": [
      8
    ]
  },
  "files": [
    "lib/",
    "src/",
    "scripts/install.js",
    "CMakeLists.txt",
    "CHANGELOG.md",
    "LICENSES/",
    "NOTICE"
  ]
}
